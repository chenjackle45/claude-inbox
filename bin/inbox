#!/bin/sh
# 收件匣指令入口：plugin 啟用時 Claude Code 會把 bin/ 放進 PATH。
# 依序試 python3、python、py -3，用第一個真的能執行的。
# Windows 的 python3／python 常是 Microsoft Store 別名（存在但不能執行）；
# 從 python.org 安裝又沒勾「加入 PATH」時，只有 py 啟動器能用。
script="$(dirname "$0")/../inbox/inbox.py"
for py in python3 python; do
  if "$py" -c '' >/dev/null 2>&1; then
    exec "$py" "$script" "$@"
  fi
done
if py -3 -c '' >/dev/null 2>&1; then
  exec py -3 "$script" "$@"
fi
echo "inbox：找不到能執行的 Python（試過 python3、python、py -3）" >&2
exit 127
